MAKEFILE      = Makefile.Debug

EQ            = =

####### Compiler, tools and options

CC            = gcc
CXX           = g++
DEFINES       = -DUNICODE -D_UNICODE -DWIN32 -DMINGW_HAS_SECURE_API=1 -DQT_MULTIMEDIAWIDGETS_LIB -DQT_MULTIMEDIA_LIB -DQT_CHARTS_LIB -DQT_WIDGETS_LIB -DQT_GUI_LIB -DQT_SQL_LIB -DQT_NETWORK_LIB -DQT_CORE_LIB -DQT_NEEDS_QMAIN
CFLAGS        = -fno-keep-inline-dllexport -g -Wall -Wextra -Wextra $(DEFINES)
CXXFLAGS      = -fno-keep-inline-dllexport -std=c++11 -Wno-unused-parameter -Wno-unused-variable -Wno-unused-function -g -std=gnu++11 -Wall -Wextra -Wextra -fexceptions -mthreads $(DEFINES)
INCPATH       = -I. -I..\..\opencv4.5.2\opencv\OpenCV-MinGW-Build-OpenCV-4.5.2-x64\include -I..\..\qt5\5.15.2\mingw81_64\include -I..\..\qt5\5.15.2\mingw81_64\include\QtMultimediaWidgets -I..\..\qt5\5.15.2\mingw81_64\include\QtMultimedia -I..\..\qt5\5.15.2\mingw81_64\include\QtCharts -I..\..\qt5\5.15.2\mingw81_64\include\QtWidgets -I..\..\qt5\5.15.2\mingw81_64\include\QtGui -I..\..\qt5\5.15.2\mingw81_64\include\QtANGLE -I..\..\qt5\5.15.2\mingw81_64\include\QtSql -I..\..\qt5\5.15.2\mingw81_64\include\QtNetwork -I..\..\qt5\5.15.2\mingw81_64\include\QtCore -Idebug -I. -I/include -I..\..\qt5\5.15.2\mingw81_64\mkspecs\win32-g++ 
LINKER      =        g++
LFLAGS        =        -Wl,-subsystem,windows -mthreads
LIBS        =        -L D:\opencv4.5.2\opencv\OpenCV-MinGW-Build-OpenCV-4.5.2-x64\x64\mingw\lib\libopencv_*.a D:\qt5\5.15.2\mingw81_64\lib\libQt5MultimediaWidgets.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Multimedia.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Charts.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Widgets.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Gui.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Sql.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Network.a D:\qt5\5.15.2\mingw81_64\lib\libQt5Core.a  -lmingw32 D:\qt5\5.15.2\mingw81_64\lib\libqtmain.a -LC:\openssl\lib -LC:\Utils\my_sql\mysql-5.7.25-winx64\lib -LC:\Utils\postgresql\pgsql\lib -lshell32 
QMAKE         = D:\qt5\5.15.2\mingw81_64\bin\qmake.exe
DEL_FILE      = del
CHK_DIR_EXISTS= if not exist
MKDIR         = mkdir
COPY          = copy /y
COPY_FILE     = copy /y
COPY_DIR      = xcopy /s /q /y /i
INSTALL_FILE  = copy /y
INSTALL_PROGRAM = copy /y
INSTALL_DIR   = xcopy /s /q /y /i
QINSTALL      = D:\qt5\5.15.2\mingw81_64\bin\qmake.exe -install qinstall
QINSTALL_PROGRAM = D:\qt5\5.15.2\mingw81_64\bin\qmake.exe -install qinstall -exe
DEL_FILE      = del
SYMLINK       = $(QMAKE) -install ln -f -s
DEL_DIR       = rmdir
MOVE          = move
IDC           = idc
IDL           = midl
ZIP           = zip -r -9
DEF_FILE      = 
RES_FILE      = 
SED           = $(QMAKE) -install sed
MOVE          = move

